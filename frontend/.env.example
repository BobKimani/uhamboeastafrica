# Uhambo frontend environment (copy to .env; never commit real values).
# NEXT_PUBLIC_* values are embedded in the browser bundle at build time —
# do not put secrets in them.

# Public FastAPI base URL (browser + server requests)
NEXT_PUBLIC_API_URL=https://api.uhamboeastafrica.com

# Locally hosted media served by the VPS
NEXT_PUBLIC_MEDIA_URL=https://api.uhamboeastafrica.com/media

# Google Maps JavaScript API key (browser key; restrict it by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional server-only backend URL for the /api proxy. Leave empty to use
# NEXT_PUBLIC_API_URL; set to http://backend:8000 to use the Docker network.
BACKEND_API_URL=
