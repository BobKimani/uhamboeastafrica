# /etc/uhambo/backend.env — runtime environment for the backend container.
# Install:  sudo install -m 600 -o root -g root backend.env.example /etc/uhambo/backend.env
# then replace every <placeholder>. Never commit the filled-in file.
#
# DB_HOST/DB_PORT, MEDIA_ROOT/MEDIA_BASE_URL, PORT and FORWARDED_ALLOW_IPS are
# set by backend/deployment/compose.backend.yaml and need not be repeated here.

# ----------------------------------------------------------------- database
# Existing PostgreSQL 17 container (service `db`, database `uhambo`).
# Use a dedicated non-superuser role that owns the application tables.
DB_NAME=uhambo
DB_USER=<uhambo_app_role>
DB_PASSWORD=<strong-random-password>
# Internal Docker network, no TLS.
DB_SSLMODE=disable

# ------------------------------------------------------ web / CORS / sessions
FRONTEND_URL=https://www.uhamboeastafrica.com
CORS_ALLOWED_ORIGINS=https://www.uhamboeastafrica.com,https://uhamboeastafrica.com
# >= 32 random characters:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=<random-48-byte-secret>
SESSION_COOKIE_NAME=uhambo_admin_session
SESSION_MAX_AGE_SECONDS=28800
SESSION_HTTPS_ONLY=true
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_MAX_FAILURES_PER_EMAIL=5
ADMIN_LOGIN_MAX_FAILURES_PER_IP=20

# ------------------------------------------------------------------ media
MEDIA_MAX_UPLOAD_BYTES=10485760

# ------------------------------------------------------------- currency
DEFAULT_USD_TO_KES_RATE=129.0
CURRENCY_CACHE_SECONDS=21600

# ------------------------------------------------- KCB Buni M-Pesa Express
# Start with sandbox values, verify one STK push + callback on the VPS, then
# switch to production. In production the app refuses to start unless the URLs
# are non-UAT, credentials are present and the callback is public HTTPS.
KCB_ENVIRONMENT=<sandbox|production>
KCB_BASE_URL=<kcb-buni-base-url>
KCB_TOKEN_URL=<kcb-buni-token-url>
KCB_CONSUMER_KEY=<from-kcb>
KCB_CONSUMER_SECRET=<from-kcb>
KCB_ROUTE_CODE=207
KCB_OPERATION=STKPush
KCB_SHARED_SHORTCODE=<true|false>
KCB_TILL_NUMBER=<from-kcb>
KCB_ORG_SHORTCODE=<from-kcb>
KCB_ACCOUNT_REFERENCE=<from-kcb>
KCB_ORG_PASSKEY=<from-kcb; required when KCB_SHARED_SHORTCODE=false>
KCB_CALLBACK_URL=https://api.uhamboeastafrica.com/api/payments/kcb/callback

# No longer used (remove if copied from AWS): COGNITO_*, OAUTH_STATE_COOKIE_NAME,
# S3_BUCKET, S3_PUBLIC_BASE_URL, AWS_REGION, DATABASE_URL.
