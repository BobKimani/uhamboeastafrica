# /etc/uhambo/frontend.env — build-time values for the frontend image.
# Install:  sudo install -m 600 -o root -g root frontend.env.example /etc/uhambo/frontend.env
# Exported by deployment/vps/uhambo-compose.sh before running docker compose.
#
# NEXT_PUBLIC_* values are embedded in the public JavaScript bundle — they are
# not secrets, and must never hold secrets. Rebuild the frontend image after
# changing anything here.

# Google Maps JavaScript API key (required by the build).
# Restrict it in Google Cloud to HTTP referrers https://www.uhamboeastafrica.com/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<browser-maps-key>

# Defaults (only set these to override):
# NEXT_PUBLIC_API_URL=https://api.uhamboeastafrica.com
# NEXT_PUBLIC_MEDIA_URL=https://api.uhamboeastafrica.com/media
# BACKEND_API_URL=http://backend:8000
