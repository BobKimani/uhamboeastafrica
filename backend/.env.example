# Admin authentication (local; replaces AWS Cognito)
# Administrator accounts live in PostgreSQL and are created with:
#   python -m app.admin_cli create --email <email> --name "<name>"
# There is no public registration and no default account.
#
# SESSION_SECRET keys the per-session CSRF tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (minimum 32 characters). Rotating it invalidates outstanding CSRF tokens.
SESSION_SECRET=<long-random-session-secret>
SESSION_COOKIE_NAME=uhambo_admin_session
# Absolute session lifetime in seconds (8 hours).
SESSION_MAX_AGE_SECONDS=28800
# Keep true so the admin session cookie is only sent over HTTPS.
# Set false only for plain-http local development.
SESSION_HTTPS_ONLY=true
# Login rate limiting (failed attempts per window).
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_MAX_FAILURES_PER_EMAIL=5
ADMIN_LOGIN_MAX_FAILURES_PER_IP=20

# Local development values. On the VPS use:
#   FRONTEND_URL=https://www.uhamboeastafrica.com
#   CORS_ALLOWED_ORIGINS=https://www.uhamboeastafrica.com,https://uhamboeastafrica.com
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL (username/password auth)
# On the VPS, DB_HOST is the `db` service on the internal Docker network.
# For local development against a local Postgres, use DB_HOST=localhost.
DB_HOST=db
DB_PORT=5432
DB_NAME=<database_name>
DB_USER=<database_user>
DB_PASSWORD=<database_password>
# disable = internal Docker network (no TLS); use require for a remote database.
DB_SSLMODE=disable

# Local media storage (replaces AWS S3 / CloudFront)
# Container path, bind-mounted from /srv/uhambo/uploads on the VPS.
MEDIA_ROOT=/app/uploads
# Public URL Nginx serves MEDIA_ROOT from (must match the frontend's NEXT_PUBLIC_MEDIA_URL).
MEDIA_BASE_URL=https://api.uhamboeastafrica.com/media
# Maximum upload size in bytes (keep Nginx client_max_body_size above this).
MEDIA_MAX_UPLOAD_BYTES=10485760

# Currency conversion
DEFAULT_USD_TO_KES_RATE=129.0
CURRENCY_CACHE_SECONDS=21600

# KCB Buni M-Pesa Express (server-only)
# With KCB_ENVIRONMENT=production the app refuses to start unless production
# (non-UAT) URLs, credentials and an HTTPS, non-localhost callback are set.
KCB_ENVIRONMENT=sandbox
KCB_BASE_URL=https://uat.buni.kcbgroup.com/mm/api/request/1.0.0
KCB_TOKEN_URL=https://uat.buni.kcbgroup.com/token?grant_type=client_credentials
KCB_CONSUMER_KEY=<consumer_key_from_kcb>
KCB_CONSUMER_SECRET=<consumer_secret_from_kcb>
KCB_ROUTE_CODE=207
KCB_OPERATION=STKPush
KCB_SHARED_SHORTCODE=true
KCB_TILL_NUMBER=<actual_kcb_till_number>
KCB_ORG_SHORTCODE=
KCB_ACCOUNT_REFERENCE=7698390
KCB_ORG_PASSKEY=
# Must be publicly reachable by KCB. On the VPS:
KCB_CALLBACK_URL=https://api.uhamboeastafrica.com/api/payments/kcb/callback
