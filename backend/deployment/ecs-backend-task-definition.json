{
  "family": "uhambo-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "taskRoleArn": "arn:aws:iam::<account-id>:role/<backend-ecs-task-role-name>",
  "executionRoleArn": "arn:aws:iam::<account-id>:role/<ecs-task-execution-role-name>",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "<account-id>.dkr.ecr.<region>.amazonaws.com/<backend-ecr-repository>:<immutable-image-tag>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "8000" },
        { "name": "DB_HOST", "value": "<aurora-writer-endpoint>" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "<aurora-database-name>" },
        { "name": "DB_USER", "value": "<database-iam-user>" },
        { "name": "DB_SSLMODE", "value": "require" },
        { "name": "AWS_REGION", "value": "<region>" },
        { "name": "FRONTEND_URL", "value": "<frontend-origin>" },
        { "name": "CORS_ALLOWED_ORIGINS", "value": "<comma-separated-allowed-origins>" },
        { "name": "SESSION_HTTPS_ONLY", "value": "true" },
        { "name": "COGNITO_REGION", "value": "<region>" },
        { "name": "COGNITO_USER_POOL_ID", "value": "<cognito-user-pool-id>" },
        { "name": "COGNITO_CLIENT_ID", "value": "<cognito-app-client-id>" },
        { "name": "COGNITO_DOMAIN", "value": "<cognito-hosted-ui-domain>" },
        { "name": "COGNITO_METADATA_URL", "value": "<cognito-oidc-metadata-url>" },
        { "name": "COGNITO_REDIRECT_URI", "value": "<backend-cognito-callback-url>" },
        { "name": "COGNITO_LOGOUT_REDIRECT_URI", "value": "<frontend-logout-url>" },
        { "name": "COGNITO_ADMIN_GROUPS", "value": "admin,admins" },
        { "name": "S3_BUCKET", "value": "<media-bucket-name>" },
        { "name": "S3_PUBLIC_BASE_URL", "value": "<cloudfront-or-s3-public-base-url>" },
        { "name": "KCB_ENVIRONMENT", "value": "production" },
        { "name": "KCB_BASE_URL", "value": "<kcb-production-base-url>" },
        { "name": "KCB_TOKEN_URL", "value": "<kcb-production-token-url>" },
        { "name": "KCB_ROUTE_CODE", "value": "<kcb-route-code>" },
        { "name": "KCB_OPERATION", "value": "STKPush" },
        { "name": "KCB_SHARED_SHORTCODE", "value": "<true-or-false>" },
        { "name": "KCB_CALLBACK_URL", "value": "<public-kcb-callback-url>" }
      ],
      "secrets": [
        { "name": "SESSION_SECRET", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<session-secret-name>:SESSION_SECRET::" },
        { "name": "COGNITO_CLIENT_SECRET", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<cognito-secret-name>:COGNITO_CLIENT_SECRET::" },
        { "name": "KCB_CONSUMER_KEY", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<kcb-secret-name>:KCB_CONSUMER_KEY::" },
        { "name": "KCB_CONSUMER_SECRET", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<kcb-secret-name>:KCB_CONSUMER_SECRET::" },
        { "name": "KCB_TILL_NUMBER", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<kcb-secret-name>:KCB_TILL_NUMBER::" },
        { "name": "KCB_ORG_SHORTCODE", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<kcb-secret-name>:KCB_ORG_SHORTCODE::" },
        { "name": "KCB_ACCOUNT_REFERENCE", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<kcb-secret-name>:KCB_ACCOUNT_REFERENCE::" },
        { "name": "KCB_ORG_PASSKEY", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<kcb-secret-name>:KCB_ORG_PASSKEY::" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5).read()\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/uhambo/backend",
          "awslogs-region": "<region>",
          "awslogs-stream-prefix": "backend"
        }
      }
    }
  ]
}
