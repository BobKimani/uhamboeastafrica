# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OS / misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# firebase service account (never commit)
firebase-service-account.json

# backend (python)
backend/uhambo/
backend/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/

# build artifacts (also ignored in frontend/.gitignore)
.next/
out/
frontend/node_modules/
frontend/*.tsbuildinfo

# vercel
.vercel

#mds
docs/

# Env files (keep .env.example tracked)
frontend/.env
backend/.env
