# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OS / misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# firebase service account (never commit)
firebase-service-account.json

# backend (python)
backend/uhambo/
backend/__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
backend/.env.example

# build artifacts (also ignored in frontend/.gitignore)
.next/
out/
frontend/node_modules/
frontend/*.tsbuildinfo

# vercel
.vercel

#mds
